@using Nop.Plugin.Misc.TurkishConsumerLaw.Areas.Admin.Models.Cookies
@model CookieDefinitionListModel

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = "Çerez Tanımları";
}

<div class="content-header clearfix">
    <h1 class="float-left">Çerez Tanımları</h1>
    <div class="float-right">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Yeni Çerez Tanımı
        </a>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="alert alert-info">
            Sitenizde kullanılan çerezler — storefront banner'da kategori bazlı listelenir.
            Default 12 tanım plugin install ile yüklenir; üçüncü taraf entegrasyonlarınız (özel pixel, cm araçları) için yenilerini ekleyin.
        </div>

        <div class="card card-default">
            <div class="card-body">
                @if (Model.Items.Any())
                {
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Sıra</th>
                                <th>Çerez Adı</th>
                                <th>Sağlayıcı</th>
                                <th>Kategori</th>
                                <th>Süre</th>
                                <th>3. Taraf</th>
                                <th>Aktif</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Items)
                            {
                                <tr>
                                    <td>@c.DisplayOrder</td>
                                    <td><code>@c.Name</code></td>
                                    <td>@c.Provider</td>
                                    <td>
                                        @{
                                            var badgeClass = c.Category switch
                                            {
                                                Nop.Plugin.Misc.TurkishConsumerLaw.Domain.Cookies.CookieCategory.Necessary => "badge-success",
                                                Nop.Plugin.Misc.TurkishConsumerLaw.Domain.Cookies.CookieCategory.Functional => "badge-info",
                                                Nop.Plugin.Misc.TurkishConsumerLaw.Domain.Cookies.CookieCategory.Analytics => "badge-warning",
                                                _ => "badge-danger"
                                            };
                                        }
                                        <span class="badge @badgeClass">@c.CategoryLabel</span>
                                    </td>
                                    <td>@c.Duration</td>
                                    <td>
                                        @if (c.IsThirdParty)
                                        {
                                            <i class="fas fa-globe text-warning" title="Üçüncü taraf"></i>
                                        }
                                    </td>
                                    <td>
                                        @if (c.IsActive)
                                        {
                                            <span class="badge badge-success">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">Pasif</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-primary">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Silmek istediğinize emin misiniz?');">
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-warning mb-0">Çerez tanımı yok.</div>
                }
            </div>
        </div>
    </div>
</section>
