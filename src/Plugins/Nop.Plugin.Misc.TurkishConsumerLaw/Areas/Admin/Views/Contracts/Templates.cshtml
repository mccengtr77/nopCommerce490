@using Nop.Plugin.Misc.TurkishConsumerLaw.Areas.Admin.Models.Contracts
@model ContractTemplateListModel

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = "Sözleşme Şablonları";
}

<div class="content-header clearfix">
    <h1 class="float-left">Sözleşme Şablonları (MSS / ÖBF)</h1>
    <div class="float-right">
        <a asp-action="CreateTemplate" class="btn btn-primary">
            <i class="fas fa-plus"></i> Yeni Şablon
        </a>
        <a asp-action="Generated" class="btn btn-default">
            <i class="fas fa-history"></i> Üretilen Sözleşmeler
        </a>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="alert alert-info">
            Default şablonlar plugin install ile yüklenir. <strong>[ŞİRKET ADI]</strong>,
            <strong>[ADRES]</strong> gibi placeholder'lar varsa kendi bilgilerinizle değiştirin.
            <strong>{{Token}}</strong> formatındaki yer tutucular sipariş bilgilerinden otomatik doldurulur
            (örn. <code>{{ÜrünListesi}}</code>, <code>{{GenelToplam}}</code>).
        </div>

        <div class="card card-default">
            <div class="card-body">
                @if (Model.Items.Any())
                {
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Tür</th>
                                <th>Ad</th>
                                <th>Versiyon</th>
                                <th>Aktif</th>
                                <th>Sıra</th>
                                <th>Güncelleme</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.Items)
                            {
                                <tr>
                                    <td>@t.Id</td>
                                    <td>
                                        <span class="badge badge-primary">@t.TypeLabel</span>
                                    </td>
                                    <td>@t.Name</td>
                                    <td>v@t.Version</td>
                                    <td>
                                        @if (t.IsActive)
                                        {
                                            <span class="badge badge-success">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">Pasif</span>
                                        }
                                    </td>
                                    <td>@t.DisplayOrder</td>
                                    <td>@(t.UpdatedOnUtc?.ToString("dd.MM.yyyy") ?? "—")</td>
                                    <td>
                                        <a asp-action="EditTemplate" asp-route-id="@t.Id" class="btn btn-sm btn-primary">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form asp-action="DeleteTemplate" asp-route-id="@t.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Şablon silinsin mi? Üretilmiş sözleşmeler etkilenmez.');">
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-warning mb-0">Şablon yok.</div>
                }
            </div>
        </div>
    </div>
</section>
