@using Nop.Plugin.Misc.TurkishConsumerLaw.Areas.Admin.Models.Kvkk
@model ExplicitConsentEditModel

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = $"Açık Rıza Düzenle — {Model.Scope}";
}

<div class="content-header clearfix">
    <h1 class="float-left">
        Açık Rıza Düzenle
        <small> — @Model.Scope</small>
    </h1>
    <div class="float-right">
        <a asp-action="Texts" class="btn btn-default">
            <i class="fas fa-arrow-left"></i> Listeye Dön
        </a>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <form asp-action="EditConsent" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Scope" />

            <div class="card card-default">
                <div class="card-body">

                    <div class="form-group row">
                        <div class="col-md-3"><label>Kapsam</label></div>
                        <div class="col-md-9">
                            <p class="form-control-plaintext"><strong>@Model.Scope</strong></p>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="ShortLabel" /></div>
                        <div class="col-md-9">
                            <nop-editor asp-for="ShortLabel" />
                            <small class="text-muted">Storefront'ta checkbox yanında gösterilen kısa metin.</small>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="Content" /></div>
                        <div class="col-md-9">
                            <textarea asp-for="Content" rows="10" class="form-control"></textarea>
                            <small class="text-muted">Detay metni (HTML kabul edilir).</small>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="Version" /></div>
                        <div class="col-md-9"><nop-editor asp-for="Version" /></div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="DisplayOrder" /></div>
                        <div class="col-md-9"><nop-editor asp-for="DisplayOrder" /></div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="DefaultChecked" /></div>
                        <div class="col-md-9">
                            <nop-editor asp-for="DefaultChecked" />
                            <small class="text-muted">
                                <strong>Dikkat:</strong> KVKK m.5 gereği açık rıza opt-in olmalı.
                                Default işaretli yapmak hukuka aykırı olabilir; sadece zorunlu kapsamlar için kullanın.
                            </small>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-3"><nop-label asp-for="IsActive" /></div>
                        <div class="col-md-9"><nop-editor asp-for="IsActive" /></div>
                    </div>
                </div>
                <div class="card-footer text-right">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Kaydet
                    </button>
                </div>
            </div>
        </form>
    </div>
</section>
